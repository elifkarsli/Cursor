# GetPark AI — Production ortam değişkenleri
# Kopyala: cp .env.production.example .env.production

SERVER_HOST=0.0.0.0
SERVER_PORT=8080
SERVER_READ_TIMEOUT_SECONDS=30
SERVER_WRITE_TIMEOUT_SECONDS=120

# Supabase PostgreSQL (Transaction Pooler önerilir — port 6543)
# Dashboard: Project Settings > Database > Connection string > Transaction pooler
DB_HOST=aws-0-eu-central-1.pooler.supabase.com
DB_PORT=6543
DB_USER=postgres.YOUR_PROJECT_REF
DB_PASSWORD=your-supabase-password
DB_NAME=postgres
DB_SSLMODE=require
DB_MAX_CONNS=10
DB_MIN_CONNS=2

# Redis yoksa backend cache'siz çalışır (hackathon için yeterli)
REDIS_HOST=
REDIS_PORT=6379

JWT_SECRET=replace-with-long-random-secret-min-32-chars
JWT_EXPIRATION_HOURS=24
JWT_ISSUER=getpark-ai

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
STREETVIEW_API_KEY=
GOOGLE_MAPS_API_KEY=

KAFKA_ENABLED=false
LOG_LEVEL=info
LOG_FORMAT=json
