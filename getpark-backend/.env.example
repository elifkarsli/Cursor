# GetPark AI Backend - Environment Variables
# masterfabric-go üzerine inşa edilmiş backend

# --- Server ---
SERVER_HOST=0.0.0.0
SERVER_PORT=8080

# --- Database (Supabase PostgreSQL) ---
DB_HOST=db.xxxx.supabase.co
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your-supabase-password
DB_NAME=postgres
DB_SSLMODE=require

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- JWT ---
JWT_SECRET=change-me-in-production-use-long-random-string
JWT_EXPIRATION_HOURS=24
JWT_ISSUER=getpark-ai

# --- GetPark AI - API Keys ---
GEMINI_API_KEY=AIzaSy...         # Google AI Studio > Get API Key
STREETVIEW_API_KEY=AIzaSy...     # Google Cloud Console > Street View Static API

# --- Kafka (opsiyonel, hackathon için false bırakabilirsin) ---
KAFKA_ENABLED=false

# --- Logging ---
LOG_LEVEL=info
LOG_FORMAT=json
